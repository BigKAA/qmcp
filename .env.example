# QDrant Configuration
QDRANT_URL=http://192.168.218.190:6333
QDRANT_API_KEY=

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Custom directory for the model cache (persist across restarts)
#EMBEDDING_CACHE_DIR=
# ONNX inference threads per process (default: min(4, CPU count))
#EMBEDDING_THREADS=4

# Server Configuration
# stdio (one process per MCP client connection) | streamable-http | sse
TRANSPORT=streamable-http
# Bind address for HTTP transports; prefer 127.0.0.1 - there is no authentication
HOST=0.0.0.0
PORT=8000

# Indexer Configuration
BATCH_SIZE=50
# Cross-process locks and stdio instance registry (default: ~/.cache/qmcp-locks)
#INDEX_LOCK_DIR=
DEBOUNCE_SECONDS=5

# Watch Configuration (comma-separated for multiple paths)
# Autostarted by HTTP daemons only; stdio agents call qdrant_watch_ensure
WATCH_PATHS=/data/repo,/data/docs
# auto: autostart for HTTP transports only; true/false overrides
#WATCH_AUTOSTART=auto

# stdio lifecycle guards
# Exit an idle stdio server after this many seconds without MCP traffic
# (the client respawns it on the next call); 0 disables
#IDLE_TIMEOUT_SECONDS=1800
# Idle period before a stdio server replaced by a newer sibling exits
#REPLACEMENT_GRACE_SECONDS=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text
